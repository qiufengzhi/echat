# eChat 生产环境后端配置模板
#
# 用法:复制为服务器上的 backend/config.yaml 并修改所有 REPLACE 占位
#   - auth.jwt_secret:必填,用 openssl rand -hex 32 生成强随机字符串
#   - sfu.nat_1_to_1_ip:必填,换成服务器公网 IP,ICE 候选回填用
#   - asr / tts 密钥:按需填写
#   - database.password / redis.password / spicedb.preshared_key:须与 .env 中
#     给对应基础设施容器( postgres / redis / spicedb )配置的凭据保持一致
#
# 分层约定:本文件是后端唯一配置源,连接地址( compose 服务名 )与全部凭据都写在这里;
# 文件不入 git,直接 scp 到服务器;基础设施容器自身的密码仍经 compose 的 .env
# 变量提供,后端侧对应字段须与之一致

server:
  addr: ":8080"               # HTTP/WebSocket 监听地址(容器内,外部经 gateway 443 转发)
  https_enabled: false        # HTTPS 由 gateway 终止,后端保持内部 HTTP
  tls_cert_file: ""           # HTTPS 证书文件路径,未启用则留空
  tls_key_file: ""            # HTTPS 私钥文件路径,未启用则留空

sfu:
  media_min_port: 50000       # WebRTC UDP 端口范围下限,与 compose 映射一致
  media_max_port: 50100       # WebRTC UDP 端口范围上限,与 compose 映射一致
  nat_1_to_1_ip: "REPLACE_WITH_SERVER_PUBLIC_IP"  # 服务器公网 IP,ICE 候选回填,必填占位
  stun_servers:               # ICE STUN 服务器列表
    - "stun:stun.l.google.com:19302"

asr:
  provider: "aliyun"          # 语音识别提供商: "aliyun" | ""(留空禁用)
  aliyun:
    access_key_id: "REPLACE_WITH_ALIYUN_ACCESS_KEY_ID"      # 阿里云 AccessKey ID,直接填写
    access_key_secret: "REPLACE_WITH_ALIYUN_ACCESS_KEY_SECRET"  # 阿里云 AccessKey Secret,直接填写
    app_key: "REPLACE_WITH_ALIYUN_NLS_APP_KEY"              # NLS 项目 AppKey,直接填写
    enable_intermediate_result: true
    enable_punctuation: true
    enable_itn: true
    max_sentence_silence_ms: 800
    session_idle_timeout: "30s"
  grpc_addr: ""                # gRPC ASR 地址,当前未启用留空

vad:
  grpc_addr: ""                # VAD gRPC 服务地址,当前未启用留空

llm:
  grpc_addr: "agent:50053"     # LLM gRPC 服务地址,compose 服务名

tts:
  provider: "xfyun"            # 语音合成提供商: "aliyun" | "xfyun" | ""
  voice: "Alicia"              # 默认语音音色
  sample_rate: 16000           # 采样率
  aliyun:                      # provider=aliyun 时使用,复用 ASR 阿里云配置
    access_key_id: ""
    access_key_secret: ""
    app_key: ""
  xfyun:                       # provider=xfyun 时使用
    app_id: ""                 # 讯飞控制台 APPID,按需填写
    api_key: ""                # 讯飞 APIKey,按需填写
    api_secret: ""             # 讯飞 APISecret,按需填写
    voice: "xiaoyan"           # 发音人
    speed: 50                  # 语速 0-100
    volume: 50                 # 音量 0-100
    pitch: 50                  # 音高 0-100
    audio_fmt: "raw"           # 音频编码: raw(pcm) / lame(mp3) / opus / opus-wb

ai:
  standby_timeout: "60s"       # 在线状态静默超时后自动转待机的时长

room:
  idle_timeout: "5m"           # 空房间清理间隔
  ws_read_buffer: 1024         # WebSocket 读缓冲区字节数
  ws_write_buffer: 1024        # WebSocket 写缓冲区字节数
  ws_check_origin: true        # 是否校验 WebSocket 来源

log:
  level: info                  # 生产建议 info
  format: json                 # 生产建议 json,便于日志采集与检索
  enable_console: true
  enable_file: true
  file_dir: logs

database:
  host: "postgres"             # compose 服务名,容器内网地址
  port: 5432                   # 容器内 PostgreSQL 端口
  user: "echat"                # 与 postgres 容器 POSTGRES_USER 一致
  password: "REPLACE_WITH_POSTGRES_PASSWORD" # 与 .env 的 POSTGRES_PASSWORD 一致(postgres 容器)
  name: "echat"                # 与 postgres 容器 POSTGRES_DB 一致
  time_zone: "Asia/Shanghai"

nats:
  url: "nats:4222"             # compose 服务名,容器内网地址
  stream: "echat_events"       # JetStream 流名,事件按 subject 落入该流
  stream_subjects:
    - "user.>"                 # 用户域事件(注册/登录/改密/封禁 等)
    - "room.>"                 # 房间域事件
  stream_max_age: "168h"       # 事件保留时长,过期由 JetStream 自动回收

outbox:
  poll_interval: "1s"          # relay 轮询 pending 事件的间隔
  batch_size: 16               # 单批取件上限
  max_attempts: 8              # 单条事件最大投递尝试次数,超限置 failed

redis:
  addr: "redis:6379"           # compose 服务名,容器内网地址
  password: "REPLACE_WITH_REDIS_PASSWORD" # 与 .env 的 REDIS_PASSWORD 一致(redis 容器 requirepass)

spicedb:
  enabled: true                # 启用对象级授权
  addr: "spicedb:50051"        # compose 服务名,容器内网地址
  preshared_key: "REPLACE_WITH_SPICEDB_PRESHARED_KEY" # 与 .env 的 SPICEDB_PRESHARED_KEY 一致(spicedb 容器)

auth:
  jwt_secret: "REPLACE_WITH_OPENSSL_RAND_HEX_32"  # access token 签名密钥,必填,openssl rand -hex 32 生成

webtransport:
  enabled: true                # 启用 WebTransport/QUIC 信令端点,不支持时自动降级 WebSocket
  # QUIC UDP 监听地址:必须只绑端口（等价于 0.0.0.0）,由 compose 的 4433:4433/udp 映射到宿主
  # ⚠️ 不要填服务器公网 IP（如 47.x.x.x:4433）:容器在 bridge 网络里没有该地址,
  #    bind 会报 "cannot assign requested address" 并导致 WebTransport 端点整个退出
  #    公网 IP 只用于 sfu.nat_1_to_1_ip（ICE 候选回填）,两者语义不同
  addr: ":4433"
  cert_file: "/etc/letsencrypt/live/echat.qxbnx.cn/fullchain.pem"  # 握手 TLS 证书,容器内路径
  key_file: "/etc/letsencrypt/live/echat.qxbnx.cn/privkey.pem"     # 握手 TLS 私钥,容器内路径