# eChat 前端本地开发环境变量示例
#
# 使用方法：
#   1. 复制本文件为 .env（或 .env.local）
#   2. 修改证书、密钥路径
#   3. 在 frontend/ 目录执行 npm run dev
#

# ---------------------------------------------------------------------------
# Vite 开发服务器
# ---------------------------------------------------------------------------

# 开发服务器端口（默认 5173）
VITE_DEV_PORT=5173

# 是否启用本地 HTTPS（true / false）
# - 本机 localhost 调试麦克风时，HTTP 通常可用
# - 手机或局域网 IP 访问时，浏览器往往要求 HTTPS 才能使用麦克风
VITE_DEV_HTTPS=false

# 仅在 VITE_DEV_HTTPS=true 时需要填写（建议使用 mkcert 生成本地可信证书）
# Windows 示例：C:/Users/<用户名>/.local/share/mkcert/localhost.pem
# macOS/Linux 示例：/home/<用户名>/.local/share/mkcert/localhost.pem
# VITE_DEV_TLS_CERT_FILE=/path/to/your/localhost.pem
# VITE_DEV_TLS_KEY_FILE=/path/to/your/localhost-key.pem

# ---------------------------------------------------------------------------
# 开发代理：将浏览器同源 /ws 转发到 Go 后端
# （仅 vite.config.ts 使用，不会注入到前端业务代码）
# ---------------------------------------------------------------------------

VITE_BACKEND_PROTOCOL=http
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=8080
